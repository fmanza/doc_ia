{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python -m ruff check scripts tests --quiet 2>&1 | head -15",
            "description": "Linting/formatting check del tooling. Requiere ruff. Opcional: false."
          },
          {
            "type": "command",
            "command": "python -m mypy scripts --no-error-summary 2>&1 | head -10",
            "description": "Type checking del tooling. Requiere mypy. Opcional: true (skip si mypy tarda).",
            "optional": true
          },
          {
            "type": "command",
            "command": "python -m pytest --collect-only -q tests 2>&1 | head -10",
            "description": "Test collection (sintaxis, no ejecución). Requiere pytest. Opcional: true.",
            "optional": true
          }
        ]
      }
    ]
  }
}
